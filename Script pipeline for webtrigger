pipeline {
    agent any

    tools {
        maven 'MAVEN_HOME'
    }

    stages {
        stage('get repo and clean') {
            steps {
                bat 'if exist SampleMavenWebProject rmdir /s /q SampleMavenWebProject'

                bat 'git clone https://github.com/sakhilesh1907/SampleMavenWebProject.git'

                bat 'mvn -f SampleMavenWebProject/pom.xml clean'
            }
        }

        stage('install') {
            steps {
                bat 'mvn -f SampleMavenWebProject/pom.xml install'
            }
        }

        stage('test') {
            steps {
                bat 'mvn -f SampleMavenWebProject/pom.xml test'
            }
        }

        stage('package') {
            steps {
                bat 'mvn -f SampleMavenWebProject/pom.xml package'
            }
        }
    }
}
